APP_NAME=Enterprise Deep Research Agent
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/v1
POSTGRES_USER=research
POSTGRES_PASSWORD=research
POSTGRES_DB=research
DATABASE_URL=postgresql+asyncpg://research:research@postgres:5432/research
LANGGRAPH_DATABASE_URL=postgresql://research:research@postgres:5432/research
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
RESEARCH_MAX_ITERATIONS=3
RESEARCH_DEFAULT_BUDGET_USD=2.00
RESEARCH_MAX_SEARCHES=30
RESEARCH_MAX_SOURCES=20
RESEARCH_MIN_COVERAGE_SCORE=0.80
RESEARCH_MIN_SOURCE_QUALITY=0.55
RESEARCH_MODE=mock
SEARCH_PROVIDER=mock
TAVILY_API_KEY=
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
CITATION_MIN_SUPPORT_SCORE=0.12
CITATION_MAX_REPAIR_ATTEMPTS=2
LLM_INPUT_COST_PER_MILLION=0.25
LLM_OUTPUT_COST_PER_MILLION=2.0
MAX_SEARCH_CONCURRENCY=5
MAX_FETCH_CONCURRENCY=5
FETCH_TIMEOUT_SECONDS=20
MAX_SOURCE_BYTES=5000000
QDRANT_COLLECTION=research_evidence
